<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FlowScope Sample"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Every screen exists in XML views, Compose, or both." />

        <Button android:id="@+id/open_login_xml" style="@style/HomeButton" android:text="Login (XML)" />
        <Button android:id="@+id/open_login_compose" style="@style/HomeButton" android:text="Login (Compose)" />
        <Button android:id="@+id/open_list_xml" style="@style/HomeButton" android:text="List (XML)" />
        <Button android:id="@+id/open_list_compose" style="@style/HomeButton" android:text="List (Compose)" />
        <Button android:id="@+id/open_web_xml" style="@style/HomeButton" android:text="WebView (XML)" />
        <Button android:id="@+id/open_web_compose" style="@style/HomeButton" android:text="WebView (Compose)" />
        <Button android:id="@+id/open_permissions" style="@style/HomeButton" android:text="Permissions" />
        <Button android:id="@+id/open_network" style="@style/HomeButton" android:text="Network and background work" />
        <Button android:id="@+id/open_referrer" style="@style/HomeButton" android:text="Install referrer" />
    </LinearLayout>
</ScrollView>
