flowscope 1
name "Sample: Compose list, scroll, and detail"
package io.github.flowscopedev.sample
mode zero-code
timeout 10000

step launch
step tap id=io.github.flowscopedev.sample:id/open_list_compose
step wait-visible id=item_1
step scroll direction=up
step scroll direction=up
step scroll direction=up
step assert-not-visible id=item_1
step scroll direction=down
step scroll direction=down
step scroll direction=down
step tap id=item_1
step assert-visible id=detail_title
step assert-visible text="This is the detail text for item 1."
step back
step wait-visible id=item_1
after force-stop
