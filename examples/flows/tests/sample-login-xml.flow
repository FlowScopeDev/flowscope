flowscope 1
name "Sample: XML login validation and success"
package io.github.flowscopedev.sample
mode zero-code
timeout 10000

# type taps the field first and appends, so each case starts from a fresh process.
before clear-app-data
step launch
step tap id=io.github.flowscopedev.sample:id/open_login_xml
step type id=io.github.flowscopedev.sample:id/email value="not-an-email"
step type id=io.github.flowscopedev.sample:id/password value="correct-horse"
step tap id=io.github.flowscopedev.sample:id/sign_in
step assert-visible text="Enter a valid email address"
step force-stop
step launch
step tap id=io.github.flowscopedev.sample:id/open_login_xml
step type id=io.github.flowscopedev.sample:id/email value="user@example.com"
step type id=io.github.flowscopedev.sample:id/password value="123"
step tap id=io.github.flowscopedev.sample:id/sign_in
step assert-visible text="Password must be at least 6 characters"
step force-stop
step launch
step tap id=io.github.flowscopedev.sample:id/open_login_xml
step type id=io.github.flowscopedev.sample:id/email value="user@example.com"
step type id=io.github.flowscopedev.sample:id/password value="correct-horse"
step tap id=io.github.flowscopedev.sample:id/sign_in
step assert-visible text="Welcome, user@example.com"
step screenshot name=welcome-xml
after force-stop
